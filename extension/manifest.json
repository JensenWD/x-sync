{
  "manifest_version": 3,
  "name": "X Bookmark Sync",
  "version": "2.0",
  "description": "Sync your X bookmarks to your local dashboard",
  "permissions": ["storage", "tabs"],
  "host_permissions": [
    "https://x.com/*",
    "http://localhost:3000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://x.com/*"],
      "js": ["intercept.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://x.com/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "X Bookmark Sync"
  }
}
