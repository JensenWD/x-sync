{
  "manifest_version": 3,
  "name": "X Bookmark Sync",
  "version": "1.0",
  "description": "Sync your X bookmarks to your local dashboard",
  "permissions": ["cookies", "storage"],
  "host_permissions": [
    "https://x.com/*",
    "https://twitter.com/*",
    "http://localhost:3000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "X Bookmark Sync"
  }
}
